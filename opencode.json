{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*cache.db*": "deny",
      "*.db-shm": "deny",
      "*.db-wal": "deny"
    },
    "edit": {
      "*": "allow",
      "cofres/obsidian/**": "deny",
      "cofres\\obsidian\\**": "deny",
      "*cofres/obsidian/*": "deny",
      "*cofres\\obsidian\\*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*cache.db*": "deny",
      "*.db-shm": "deny",
      "*.db-wal": "deny",
      "dist/**": "deny",
      "dist\\**": "deny",
      "*dist/*": "deny",
      "node_modules/**": "deny",
      "node_modules\\**": "deny",
      "*node_modules/*": "deny",
      "logs/**": "deny",
      "logs\\**": "deny",
      "*logs/*": "deny",
      "*.log": "deny"
    },
    "glob": {
      "*": "allow",
      "cofres/obsidian/**": "deny",
      "cofres\\obsidian\\**": "deny",
      "*cofres/obsidian/*": "deny",
      "*cofres\\obsidian\\*": "deny",
      "*node_modules/*": "deny",
      "*dist/*": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "pnpm build*": "allow",
      "pnpm dev*": "allow",
      "python3 backend/smoke_test.py*": "allow",
      "rm -rf *": "deny",
      "rm *": "deny",
      "del *": "deny",
      "rd *": "deny",
      "rmdir *": "deny",
      "Remove-Item *": "deny",
      "Set-Content *": "deny",
      "Out-File *": "deny",
      "Add-Content *": "deny",
      "Move-Item *obsidian*": "deny",
      "Copy-Item *obsidian*": "deny",
      "Move-Item *cofres*": "deny",
      "Copy-Item *cofres*": "deny",
      "export *": "deny"
    },
    "skill": {
      "*": "allow"
    },
    "webfetch": "ask"
  }
}
