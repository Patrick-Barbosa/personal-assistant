# Tiba — copie para .env e preencha as chaves (o .env nunca é commitado).
# O backend lê o .env sozinho e nunca sobrescreve variável real de ambiente.

# Chat com notas (obrigatório p/ o agente)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Voz no chat: microfone -> texto via Groq Whisper (obrigatório p/ gravar áudio)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3-turbo

# Banco + porta (opcionais, estes são os padrões)
DB_PATH=cofres/cache.db
BACKEND_PORT=8000
