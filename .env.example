# Copernico — copie para .env (raiz) e preencha. Nunca commite o .env.
# Paths relativos resolvem a partir da raiz do projeto (src-tauri/ nunca é raiz).

# Cofres de notas
VAULT_PATH=cofres/default
OBSIDIAN_VAULT_PATH=cofres/obsidian

# Banco SQLite local
DB_PATH=cofres/cache.db

# LLM DeepSeek (OpenAI-compatible; base SEM /v1 — o cliente adiciona /chat/completions)
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Atalho global do overlay
HOTKEY=ctrl+space

# Voz — STT via Groq Whisper
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=whisper-large-v3-turbo

# Paths opcionais (defaults ao lado; só defina se for mudar)
WAKE_WORD_MODELS_DIR=motor_wake_word
PLUGINS_PATH=plugins
SKILLS_PATH=skills
GREETINGS_PATH=cofres/greetings
